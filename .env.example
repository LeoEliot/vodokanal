# ==================== Database ====================
POSTGRES_DB=vodokanal
POSTGRES_USER=vodokanal
POSTGRES_PASSWORD=vodokanal_password

# ==================== Redis ====================
REDIS_URL=redis://localhost:6379

# ==================== RabbitMQ ====================
RABBITMQ_URL=amqp://vodokanal:vodokanal_password@localhost:5672/
RABBITMQ_DEFAULT_USER=vodokanal
RABBITMQ_DEFAULT_PASS=vodokanal_password

# ==================== JWT ====================
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ==================== Payment Gateways ====================
# YooKassa (Yandex Money)
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key

# Stripe
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ==================== SMTP (Email Notifications) ====================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@vodokanal.ru
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@vodokanal.ru

# ==================== Service Ports ====================
GATEWAY_PORT=8080
AUTH_PORT=8081
SUBSCRIBERS_PORT=8082
READINGS_PORT=8083
BILLING_PORT=8084
PAYMENTS_PORT=8085
TICKETS_PORT=8086
COUNTERS_PORT=8087
NOTIFICATIONS_PORT=8088

# ==================== Frontend ====================
VITE_API_URL=http://localhost:8080/api/v1
